# Every variable is optional. Missing values degrade features, never crash the app.
# No MONGODB_URI = demo mode (in-memory sample data, auth bypassed).

APP_URL=                    # e.g. https://moneypilot.example.com (used for WebAuthn origin)
MONGODB_URI=                # mongodb+srv://...
MONGODB_DB=moneypilot
ENCRYPTION_KEY=             # 32 bytes, base64 or hex: openssl rand -base64 32 (required in production)

# Auth
ALLOW_SIGNUP=false          # first user can always sign up; set true to allow more
WEBAUTHN_RP_ID=             # defaults to APP_URL / request hostname
WEBAUTHN_RP_NAME=MoneyPilot
RESEND_API_KEY=             # Phase 1 magic links
EMAIL_FROM=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox           # sandbox | production
PLAID_WEBHOOK_URL=          # https://<domain>/api/plaid/webhook
CRON_SECRET=                # Vercel Cron bearer token for /api/cron/sync

# AI
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_VISION_MODEL=           # vision-capable model id on the same API, for photos and scanned PDFs

# Storage: private Vercel Blob for document originals (parsing works without it)
BLOB_READ_WRITE_TOKEN=

DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=America/New_York
